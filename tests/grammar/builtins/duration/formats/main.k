import duration

iso = duration.parse("PT1H30M")
week = duration.parse("P1W")
day_time = duration.parse("P1DT2H3M4S")
millis = duration.parse("500ms")
millis_norm = duration.parse("1500ms")
micros = duration.parse("2us")
nanos = duration.parse("100ns")
combined = duration.parse("1h30m500ms")
iso_frac = duration.parse("PT0.5S")
dup = duration.parse("1h1h")
iso_out = duration.to_iso8601("1h30m")
iso_day = duration.to_iso8601("1d2h3m4s")
iso_zero = duration.to_iso8601("0s")
iso_frac_out = duration.to_iso8601("1.5s")
iso_week = duration.to_iso8601("7d")
ms_ctor = duration.millisecond(500)
ms_ctor_whole = duration.millisecond(1500)
valid_iso = duration.is_valid("PT1H30M")
valid_ms = duration.is_valid("500ms")
valid_us = duration.is_valid("1µs")
invalid_year = duration.is_valid("P1Y")
invalid_month = duration.is_valid("P1M")
valid_minute = duration.is_valid("PT1M")
invalid_order = duration.is_valid("1ms1s")
valid_order = duration.is_valid("1s1ms")
invalid_space = duration.is_valid("1h 30m")
